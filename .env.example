# ==============================================================================
# KKS Smart Retail POS — Multi-Cloud & Multi-Base Environment Configuration
# ==============================================================================
# Copy this file to `.env` for local development or configure in your cloud host.
# NEVER commit your actual `.env` file or secret keys to GitHub.

# --- Server & Hosting ---
PORT="3000"
APP_URL="http://localhost:3000"

# --- AI Market Price Search (Optional - works with built-in fallback if omitted) ---
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# --- Multi-Cloud Database Option A: Standard PostgreSQL URL (Neon, Supabase, Railway, Render, Docker) ---
# DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
# SQL_SSL="true"

# --- Multi-Cloud Database Option B: Google Cloud SQL (PostgreSQL) ---
# SQL_HOST="127.0.0.1"
# SQL_USER="app_user"
# SQL_PASSWORD="YOUR_DB_PASSWORD"
# SQL_DB_NAME="pos_db"
# SQL_ADMIN_USER="postgres"
# SQL_ADMIN_PASSWORD="YOUR_ADMIN_PASSWORD"

# Note: If neither DATABASE_URL nor SQL_HOST is set, the backend automatically
# activates its zero-config Portable Local JSON Multi-Base store so anyone can
# run the POS server for free immediately after cloning from GitHub!
